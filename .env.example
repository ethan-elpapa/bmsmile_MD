# ---- 저장소 ----
# Vercel → Storage 에서 Redis 를 붙이면 이 둘은 자동으로 주입된다.
# 로컬에서 서버와 같은 데이터를 보고 싶을 때만 여기에 복사해 넣는다.
# 비워 두면 .data/board.json 파일에 저장하며 돌아간다 (로컬 전용).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 선택. 한 저장소에 보드를 여러 개 둘 때만 바꾼다. 기본 kpi-board
BOARD_KEY_NAME=

# ---- 편집 권한 ----
# 넣으면 이 키를 아는 사람만 고칠 수 있다. 비우면 주소를 아는 사람 누구나 고칠 수 있다.
BOARD_WRITE_KEY=

# ---- 실적 시트 (선택) ----
# 이름 규칙은 SHEET_<마켓>_<브랜드>_<채널> 다. 칸마다 시트가 따로 붙는다.
# 넣은 칸만 시트에서 읽어 오고, 안 넣은 칸은 손으로 넣는 줄로 남는다.
# 서비스 계정을 쓰지 않는다 — 시트가 '링크가 있는 사람은 보기' 여야 한다.
# 값은 문서 ID(주소의 /d/ 와 /edit 사이), _GID 는 일별 롤업 탭의 gid.
SHEET_US_MUMUKI_AMAZON=
SHEET_US_MUMUKI_AMAZON_GID=0
SHEET_US_MUMUKI_D2C=
SHEET_US_MUMUKI_D2C_GID=0
SHEET_US_PETHROOM_AMAZON=
SHEET_US_PETHROOM_AMAZON_GID=0
SHEET_US_PETHROOM_D2C=
SHEET_US_PETHROOM_D2C_GID=0

# 캐나다를 열면 SHEET_CA_MUMUKI_AMAZON 처럼 같은 규칙으로 늘린다.

# 시트를 다시 읽는 주기(초). 기본 300
FEED_REVALIDATE_SECONDS=
